{
  "name": "tristan-portfolio",
  "version": "0.0.0",
  "private": true,
  "description": "My personal portfolio & my github main page.",
  "repository": {
    "type": "git",
    "url": "https://github.com/tristanjcb/tristanjcb.git"
  },
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "node --experimental-strip-types scripts/sitemap.ts && next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "oxlint --deny-warnings",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "test:smoke": "playwright test",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "prepare": "husky",
    "perf": "node scripts/performance.mjs",
    "perf:check": "node scripts/performance-budget.mjs"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "next": "16.4.3",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "rehype-pretty-code": "^0.14.1",
    "remark-gfm": "^4.0.1",
    "shiki": "^3.0.0",
    "three": "0.187.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-angular": "^21.2.0",
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.186.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "sass": "^1.90.0",
    "typescript": "~6.0.2"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@12.16.1"
}
