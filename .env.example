# Optional: only set after the official URL has been confirmed.
# YOUTUBE_URL=https://www.youtube.com/@your-confirmed-channel

# Server-only read tokens. Never prefix with NEXT_PUBLIC_.
# GitHub classic PAT with read:user + read:org, able to query public Sponsors data.
GITHUB_SPONSORS_TOKEN=
# Legacy Buy Me a Coffee API read-only token (availability depends on account).
BUYMEACOFFEE_TOKEN=
